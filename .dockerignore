# Send only build inputs to Docker, never local collections or credentials.
**
!Dockerfile
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.server.json
!vite.config.ts
!index.html
!LICENSE
!THIRD_PARTY_NOTICES.md
!src/
!src/**

# These exclusions also apply if someone puts local files beneath src/.
**/.env
**/.env.*
**/.npmrc
**/*.env.json
**/*.local.json
**/.requestdock*
